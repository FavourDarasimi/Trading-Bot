# Copy to .env and fill in. The bot & SDK read these when arguments are omitted.

# 1. Your Loaf USER API KEY — used as the Bearer token.
# Mint one from the Loaf web app: log in -> Settings -> API keys -> Create.
# (https://beta.loafmarkets.com/api)
LOAF_API_KEY=

# 2. REST base URL, INCLUDING the trailing /api.
# Production / Beta: https://api.loafmarkets.com/api
LOAF_API_BASE_URL=https://api.loafmarkets.com/api

# 3. Target Property Token (lowercase tokenName, e.g. "opera")
LOAF_TARGET_TOKEN=opera

# 4. Target Portfolio Utilization (0.70 = 70% of total portfolio equity)
LOAF_PORTFOLIO_PCT=0.70

# 5. Optional: your numeric Loaf user id (from the web app). Needed to
# subscribe to the PRIVATE portfolio WebSocket channel for instant fill stream.
# LOAF_USER_ID=

# 6. Optional: override the WebSocket URL. If unset it is derived from the base URL
# (https://host/api -> wss://host/ws, http://host/api -> ws://host/ws).
# LOAF_WS_URL=wss://api.loafmarkets.com/ws
